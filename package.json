{
  "name": "year-clock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist/client --project-name year-clock",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.jsonc",
    "refresh-data": "tsx scripts/refresh-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource-variable/newsreader": "^5.1.1",
    "@fontsource-variable/space-grotesk": "^5.1.1",
    "@js-temporal/polyfill": "^0.5.1",
    "astronomy-engine": "^2.1.19",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "tsx": "^4.20.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.4",
    "wrangler": "^4.118.0"
  }
}